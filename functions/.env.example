# Copy to .env for local emulator-only development. Never commit real values.
APP_CHECK_ENFORCE_CALLABLES=enforce
AGORA_APP_ID=replace-with-agora-app-id
AGORA_APP_CERTIFICATE=replace-with-agora-app-certificate
RAZORPAY_KEY_ID=replace-with-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
