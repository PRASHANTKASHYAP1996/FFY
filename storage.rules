rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isProfilePhotoOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAllowedProfilePhotoUpload() {
      return request.resource != null &&
          request.resource.size < 5 * 1024 * 1024 &&
          request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function isSocialUploadOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAllowedSocialUpload() {
      return request.resource != null &&
          request.resource.size < 8 * 1024 * 1024 &&
          request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)');
    }

    function isCanonicalSocialPostImage(fileName) {
      return fileName.matches('^[A-Za-z0-9_.-]+\\.jpg$');
    }

    match /profile_photos/{userId}/profile.jpg {
      allow read: if true;
      allow create, update: if isProfilePhotoOwner(userId) &&
          isAllowedProfilePhotoUpload();
      allow delete: if isProfilePhotoOwner(userId);
    }

    match /social_uploads/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isSocialUploadOwner(userId) &&
          isCanonicalSocialPostImage(fileName) &&
          isAllowedSocialUpload();
      allow delete: if isSocialUploadOwner(userId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
